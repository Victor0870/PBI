                "    #\"Extracted First Characters\" = Table.TransformColumns(#\"Removed Columns2\", {{\"Comp Material\", each Text.Start(_, 8), type text}})",
                "in",
                "    #\"Extracted First Characters\""
              ],
              "type": "m"
            }
