                "    Dim_BangGocSAP = Table.SelectColumns(#\"Dim_Changed Type\",{\"LV-Code\", \"SAP code\"}),",
                "    #\"Dim_Merged Queries\" = Table.NestedJoin(#\"Dim_Changed Type\", {\"Re-blend of \"}, Dim_BangGocSAP, {\"LV-Code\"}, \"Dim_BangGocSAP\", JoinKind.LeftOuter),",
                "    #\"Dim_Expanded BangGocSAP\" = Table.ExpandTableColumn(#\"Dim_Merged Queries\", \"Dim_BangGocSAP\", {\"SAP code\"}, {\"SAP code.1\"}),",
                "    #\"Dim_Renamed Columns\" = Table.RenameColumns(#\"Dim_Expanded BangGocSAP\",{{\"SAP code.1\", \"SAP_Code_Gốc_Mượn\"}}),",
                "    #\"Dim_Added Custom\" = Table.AddColumn(#\"Dim_Renamed Columns\", \"Mã_Bulk_Chuẩn\", each if [#\"Re-blend of \"] = null or [#\"Re-blend of \"] = \"\" then Text.From([SAP code]) else Text.From([SAP_Code_Gốc_Mượn])),",
                "    DimMapping = Table.SelectRows(Table.RemoveColumns(#\"Dim_Added Custom\",{\"SAP_Code_Gốc_Mượn\"}), each ([Mã_Bulk_Chuẩn] <> null)),",
                "    BOM_Source = Excel.Workbook(File.Contents(\"D:\\Box\\05. Supply Chain Management\\1. SCM (Planning)\\PowerBI\\Updated format IAIB daily 13.05.xlsx\"), null, true),",
                "    #\"BOM_Sheet\" = BOM_Source{[Item=\"BOM\",Kind=\"Sheet\"]}[Data],",
                "    #\"BOM_Promoted Headers\" = Table.PromoteHeaders(#\"BOM_Sheet\", [PromoteAllScalars=true]),",
