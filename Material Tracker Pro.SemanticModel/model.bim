            "name": "FC Period Select",
            "mode": "import",
            "source": {
              "expression": [
                "VAR _Base = DATE(YEAR(TODAY()), MONTH(TODAY()), 1)",
                "RETURN",
                "UNION(",
                "    ROW(\"Label\", \"Tháng hiện tại\", \"Month FC\", _Base, \"Demand Source\", \"FC\"),",
                "    ROW(\"Label\", \"Tháng tiếp theo\", \"Month FC\", EDATE(_Base, 1), \"Demand Source\", \"FC\"),",
                "    ROW(\"Label\", \"Tháng tiếp theo nữa\", \"Month FC\", EDATE(_Base, 2), \"Demand Source\", \"FC\"),",
                "    ROW(\"Label\", \"Tháng trước (SX thực tế)\", \"Month FC\", EDATE(_Base, -1), \"Demand Source\", \"Actual\")",
                ")"
              ],
              "type": "calculated"
            }
