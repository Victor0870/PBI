        "lineageTag": "825fa9ec-eeb9-44bf-b68d-73c7476216c6",
        "partitions": [
          {
            "name": "Calendar",
            "mode": "import",
            "source": {
              "expression": [
                "",
                "VAR _MinDate = MIN('PO list'[ETA]) // Hoặc chọn ngày bắt đầu của Forecast, tùy bảng nào có ngày nhỏ nhất",
                "VAR _MaxDate = MAX('FC'[Month FC]) // Lấy ngày xa nhất trong tương lai của Forecast",
                "",
                "RETURN",
                "ADDCOLUMNS (",
                "    CALENDAR ( _MinDate, _MaxDate ),",
                "    \"Year\", YEAR ( [Date] ),",
                "    \"Month No\", MONTH ( [Date] ),",
                "    \"Month Name\", FORMAT ( [Date], \"mmm\" ),",
                "    \"Year Month\", FORMAT ( [Date], \"yyyy-mm\" ),",
                "    \"Quarter\", \"Q\" & FORMAT ( [Date], \"q\" )",
                ")"
              ],
              "type": "calculated"
            }
          }
        ]
      },
