        "partitions": [
          {
            "name": "Dim_Mapping_Code",
            "mode": "import",
            "source": {
              "expression": [
                "let",
                "    Source = Excel.Workbook(File.Contents(\"D:\\Box\\05. Supply Chain Management\\1. SCM (Planning)\\PowerBI\\Code LV.xlsx\"), null, true),",
                "    #\"Density-8digital code_Sheet\" = Source{[Item=\"Density-8digital code\",Kind=\"Sheet\"]}[Data],",
                "    #\"Promoted Headers\" = Table.PromoteHeaders(#\"Density-8digital code_Sheet\", [PromoteAllScalars=true]),",
                "    #\"Changed Type\" = Table.TransformColumnTypes(#\"Promoted Headers\",{{\"LV-Code\", type text}, {\"Re-blend of \", type text}, {\"SAP code\", type text}, {\"Product Name\", type text}, {\"Density @15\", type number}}),",
                "    BangGocSAP = Table.SelectColumns(#\"Changed Type\",{\"LV-Code\", \"SAP code\"}),",
                "    #\"Merged Queries\" = Table.NestedJoin(#\"Changed Type\", {\"Re-blend of \"}, BangGocSAP, {\"LV-Code\"}, \"Bảng_Gốc_SAP\", JoinKind.LeftOuter),",
                "    #\"Expanded Bảng_Gốc_SAP\" = Table.ExpandTableColumn(#\"Merged Queries\", \"Bảng_Gốc_SAP\", {\"SAP code\"}, {\"SAP code.1\"}),",
                "    #\"Renamed Columns\" = Table.RenameColumns(#\"Expanded Bảng_Gốc_SAP\",{{\"SAP code.1\", \"SAP_Code_Gốc_Mượn\"}}),",
                "    #\"Added Custom\" = Table.AddColumn(#\"Renamed Columns\", \"Mã_Bulk_Chuẩn\", each if [#\"Re-blend of \"] = null or [#\"Re-blend of \"] = \"\" then Text.From([SAP code]) else Text.From([SAP_Code_Gốc_Mượn])),",
                "    #\"Removed Columns\" = Table.RemoveColumns(#\"Added Custom\",{\"SAP_Code_Gốc_Mượn\"}),",
                "    #\"Filtered Rows\" = Table.SelectRows(#\"Removed Columns\", each ([Mã_Bulk_Chuẩn] <> null))",
                "in",
                "    #\"Filtered Rows\""
              ],
              "type": "m"
            }
          }
        ]
      },
