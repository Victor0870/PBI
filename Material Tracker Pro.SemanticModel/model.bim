        "lineageTag": "a3c6c4d5-ab8f-4450-95d7-0b3d264db2dd",
        "partitions": [
          {
            "name": "Code Packing",
            "mode": "import",
            "source": {
              "expression": [
                "let",
                "    Source = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText(\"\", BinaryEncoding.Base64), Compression.Deflate)), let _t = ((type nullable text) meta [Serialized.Text = true]) in type table [#\"Code packing\" = _t, KL = _t, #\"Name packing\" = _t]),",
                "    #\"Changed Type\" = Table.TransformColumnTypes(Source,{{\"Code packing\", type text}, {\"KL\", type number}, {\"Name packing\", type text}})",
                "in",
                "    #\"Changed Type\""
              ],
              "type": "m"
            }
          }
        ]
      },
      {
        "name": "_Measures",
        "annotations": [
          {
            "name": "PBI_ResultType",
            "value": "Table"
          }
        ],
        "lineageTag": "c4b9cf2b-fcfb-40da-84f0-3679f2659f0d",
        "measures": [
          {
            "name": "Total_production_KG",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ],
            "expression": "SUM('Production Plan'[KG])",
            "lineageTag": "f64aa77c-e58c-43df-b8a7-91aefbafe873"
          },
          {
            "name": "Total_stock_Product_KG",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ],
            "expression": [
              "",
              "SUMX(",
              "    'Stock-Product',",
              "    'Stock-Product'[Stock ST]",
              "    * RELATED('Code Packing'[KL]) ",
              "    * 1000 ",
              "    * RELATED('Product Category'[Density @15])",
              ")"
            ],
            "lineageTag": "f81de3a1-e4c3-42e3-8b00-cf303d1a369b"
          },
          {
            "name": "Total_FC_KG",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ],
            "expression": [
              "",
              "SUMX(",
              "    FC,",
              "    FC[Value]",
              "    * RELATED('Code Packing'[KL]) ",
              "    * 1000 ",
              "    * RELATED('Product Category'[Density @15])",
              ")"
            ],
            "lineageTag": "a02ae4e5-6dd7-43a8-bcc7-88f6ddde85b1"
          },
          {
            "name": "FC_avarage_KG",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ],
            "expression": [
              "",
              "DIVIDE([Total_FC_KG], 3, 0)"
            ],
            "lineageTag": "463d0e1c-950b-494b-9538-9915257469be"
          },
          {
            "name": "Demand_additive_KG",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ],
            "expression": [
              "",
              "SUMX(",
              "    BOM,",
              "    [Total_FC_KG] * BOM[ (%)] / 1000",
              ")"
            ],
            "lineageTag": "4c525523-5671-48ef-a76f-cdfe0bb4d9ca"
          },
          {
            "name": "Total_Stock_Additive_KG",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ],
            "expression": "SUM('Stock-Material'[Total KG])",
            "lineageTag": "cf99c406-3cfa-4b38-9c0a-f9066bf498d5"
          },
          {
            "name": "Total_incomming_KG",
            "expression": "SUM('PO list'[Means (KG)])",
            "formatString": "0",
            "lineageTag": "6c321e06-f993-4118-8b1b-7adb188292ca"
          },
          {
            "name": "Stock_Additive_luy_ke_KG",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ],
            "expression": [
              "",
              "VAR _Ngay_Dang_Xet = MAX('Calendar'[Date])",
              "",
              "-- 1. Lấy trực tiếp ngày đầu tháng duy nhất đang có trong bảng Opening Stock",
              "VAR _Ngay_Goc = CALCULATE(MIN('Opening Stock'[To Date]), REMOVEFILTERS('Calendar'))",
              "",
              "-- 2. Lấy số tồn đầu tháng tương ứng (Xóa lọc từ trục ngày để không bị trống số)",
              "VAR _Ton_Dau_Ky = CALCULATE([Total_Opening_Stock_KG], REMOVEFILTERS('Calendar'))",
              "",
              "-- 3. Tính lũy tiến lịch tàu về từ Ngày Gốc đến Ngày Đang Xét",
              "VAR _Luy_Tien_Tau_Ve = ",
              "    CALCULATE(",
              "        [Total_incomming_KG],",
              "        FILTER(",
              "            ALL('Calendar'),",
              "            'Calendar'[Date] >= _Ngay_Goc && 'Calendar'[Date] <= _Ngay_Dang_Xet",
              "        )",
              "    )",
              "",
              "-- 4. Tính lũy tiến tiêu hao từ Ngày Gốc đến Ngày Đang Xét",
              "VAR _Luy_Tien_Tieu_Hao_Sx = ",
              "    CALCULATE(",
              "        [Demand_Additive_From_Production_KG],",
              "        FILTER(",
              "            ALL('Calendar'),",
              "            'Calendar'[Date] >= _Ngay_Goc && 'Calendar'[Date] <= _Ngay_Dang_Xet",
              "        )",
              "    )",
              "",
              "RETURN",
              "    -- Nếu biểu đồ hiển thị các ngày trước Ngày Gốc (tháng cũ) thì ẩn đi, chỉ vẽ từ tháng hiện tại",
              "    IF(",
              "        _Ngay_Dang_Xet < _Ngay_Goc,",
              "        BLANK(),",
              "        _Ton_Dau_Ky + _Luy_Tien_Tau_Ve - _Luy_Tien_Tieu_Hao_Sx",
              "    )"
            ],
            "lineageTag": "e8c33f29-5361-4536-930d-4cb0178ee364"
          },
          {
            "name": "Demand_Additive_From_Production_KG",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ],
            "expression": [
              "",
              "VAR _Material = MAX('BOM'[Material name])",
              "VAR _Code8 = [Scenario_Context_Code8]",
              "RETURN",
              "    SUMX(",
              "        FILTER(",
              "            'Production Plan',",
              "            (ISBLANK(_Material) || 'Production Plan'[Material name] = _Material)",
              "                && (ISBLANK(_Code8) || 'Production Plan'[Code 8] = _Code8)",
              "        ),",
              "        'Production Plan'[KG] * 'Production Plan'[Percentage]",
              "    )"
            ],
            "lineageTag": "f2952513-60bd-4394-aa27-7b092a190f84"
          },
          {
            "name": "Total_Opening_Stock_KG",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ],
            "expression": "SUM('Opening Stock'[Stock Kg])",
            "lineageTag": "86438fd7-3c8a-415e-b8a7-54a01a6d7110"
          },
          {
            "name": "Max_Axis_Value",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ],
            "expression": [
              "",
              "-- Lấy danh sách các ngày đang xuất hiện trên trục hoành của biểu đồ",
              "VAR _Danh_Sach_Ngay = VALUES('Calendar'[Date])",
              "",
              "-- Tìm giá trị cao nhất của Cột Tàu Về trong khoảng thời gian đang xem",
              "VAR _Max_Means = MAXX(_Danh_Sach_Ngay, CALCULATE(SUM('PO list'[Means (KG)])))",
              "",
              "-- Tìm giá trị cao nhất của Cột Tiêu Hao trong khoảng thời gian đang xem",
              "VAR _Max_Demand = MAXX(_Danh_Sach_Ngay, [Demand_Additive_From_Production_KG])",
              "",
              "-- Tìm giá trị cao nhất của Đường Lũy Kế Tồn Kho trong khoảng thời gian đang xem",
              "VAR _Max_Stock = MAXX(_Danh_Sach_Ngay, [Stock_Additive_luy_ke_KG])",
              "",
              "-- Lấy giá trị lớn nhất tuyệt đối trong 3 chuỗi dữ liệu và cộng thêm 10% khoảng trống trần đồ thị",
              "RETURN ",
              "    MAX(MAX(_Max_Means, _Max_Demand), _Max_Stock) * 1.1"
            ],
            "lineageTag": "2d8ddc9e-9de6-4480-a06f-f888da52eac2"
          },
          {
            "name": "warning_low_stock",
            "expression": [
              "",
              "-- 1. Lấy danh sách các Phụ gia đang có (bỏ qua bộ lọc riêng lẻ nếu có để quét được toàn bộ)",
              "VAR _Danh_Sach_Phu_Gia = ALLSELECTED('Stock-Material'[Material Description])",
              "",
              "-- 2. Tạo một bảng ảo tính toán mức tồn kho thấp nhất trong tháng của từng loại phụ gia",
              "VAR _Bang_Tieu_Chi = ",
              "    ADDCOLUMNS(",
              "        _Danh_Sach_Phu_Gia,",
              "        \"@TonMinTrongThang\", ",
              "            MINX(",
              "                ALLSELECTED('Calendar'[Date]), ",
              "                [Stock_Additive_luy_ke_KG]",
              "            )",
              "    )",
              "",
              "-- 3. Loại bỏ các phụ gia không có dữ liệu tồn kho (Tránh bị lấy nhầm số 0 hoặc Blank)",
              "VAR _Bang_Loc = FILTER(_Bang_Tieu_Chi, NOT(ISBLANK([@TonMinTrongThang])) && [@TonMinTrongThang] > 0)",
              "",
              "-- 4. Xác định mức tồn kho thấp nhất tuyệt đối trong hệ thống",
              "VAR _Muc_Ton_Thap_Nhat = MINX(_Bang_Loc, [@TonMinTrongThang])",
              "",
              "-- 5. Tìm tên phụ gia tương ứng với mức tồn thấp nhất đó",
              "VAR _Ten_Phu_Gia = MAXX(FILTER(_Bang_Loc, [@TonMinTrongThang] = _Muc_Ton_Thap_Nhat), 'Stock-Material'[Material Description])",
              "",
              "RETURN",
              "    IF(",
              "        ISBLANK(_Ten_Phu_Gia),",
              "        \"Hệ thống chưa có dữ liệu tồn kho.\",",
              "        \"⚠️ CẢNH BÁO: Phụ gia có mức tồn thấp nhất là [\" & _Ten_Phu_Gia & \"] (Chạm đáy: \" & FORMAT(_Muc_Ton_Thap_Nhat, \"#,##0\") & \" KG).\"",
              "    )"
            ],
            "lineageTag": "0a042420-54ed-431a-a733-dfe222b0df4d"
          },
          {
            "name": "Filter_product_same_additive",
            "expression": [
              "",
              "-- 1. Sử dụng CALCULATETABLE để ép buộc kết quả trả về luôn là 1 BẢNG chứa danh sách phụ gia từ Slicer",
              "VAR _Phu_Gia_Slicer = ",
              "    CALCULATETABLE(",
              "        VALUES('BOM'[Code 8 Material]),",
              "        ALLSELECTED('BOM'[Product])",
              "    )",
              "",
              "-- 2. Lấy mã Code 8 của dòng sản phẩm đang xét hiện tại ở Bảng 3",
              "VAR _Code8_Dong_Hien_Tai = SELECTEDVALUE('Product Category'[Code 8])",
              "",
              "-- 3. Tiếp tục ép kết quả trả về là 1 BẢNG chứa danh sách phụ gia của dòng hiện tại",
              "VAR _Phu_Gia_Dong_Hien_Tai = ",
              "    CALCULATETABLE(",
              "        VALUES('BOM'[Code 8 Material]),",
              "        REMOVEFILTERS('BOM'),",
              "        'BOM'[Code 8] = _Code8_Dong_Hien_Tai",
              "    )",
              "",
              "-- 4. Tìm các phụ gia chung giữa 2 BẢNG dữ liệu trên",
              "VAR _Giao_Nhau = INTERSECT(_Phu_Gia_Slicer, _Phu_Gia_Dong_Hien_Tai)",
              "",
              "RETURN",
              "    -- Nếu có ít nhất 1 phụ gia chung thì trả về 1, không thì ẩn đi (Blank)",
              "    IF(NOT(ISEMPTY(_Giao_Nhau)), 1, BLANK())"
            ],
            "formatString": "0",
            "lineageTag": "e0236d84-0525-40bc-ad56-643f4e6d51b5"
          },
          {
            "name": "Stock_product_st",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ],
            "expression": [
              "",
              "CALCULATE(",
              "    SUM('Stock-Product'[Stock ST]",
              "            ",
              "    ),",
              "    REMOVEFILTERS('BOM'[Product]) -- Xóa lọc từ Slicer để hiển thị được tồn kho của các sản phẩm khác",
              ")"
            ],
            "lineageTag": "095a7929-d292-4a46-802e-04260ba81159"
          },
          {
            "name": "Product_Use",
            "expression": [
              "",
              "-- 1. Xác định mã Code 8 của loại phụ gia đang xét trên từng dòng của Bảng 2",
              "VAR _Ma_Phu_Gia_Hien_Tai = SELECTEDVALUE('BOM'[Code 8 Material])",
              "",
              "RETURN",
              "    IF(",
              "        ISBLANK(_Ma_Phu_Gia_Hien_Tai),",
              "        BLANK(),",
              "        -- 2. Đếm số lượng sản phẩm độc nhất trong bảng BOM có sử dụng mã phụ gia này",
              "        CALCULATE(",
              "            DISTINCTCOUNT('BOM'[Product]),",
              "            REMOVEFILTERS('BOM'), -- Xóa bỏ hoàn toàn bộ lọc từ Slicer sản phẩm chính để quét toàn hệ thống",
              "            'BOM'[Code 8 Material] = _Ma_Phu_Gia_Hien_Tai",
              "        )",
              "    )"
            ],
            "formatString": "0",
            "lineageTag": "d6f9046b-4129-4c6a-9887-09ba3a4517af"
          },
          {
            "name": "Scenario_Context_Code8",
            "expression": [
              "",
              "COALESCE(",
              "    SELECTEDVALUE('Product Category'[Code 8]),",
              "    SELECTEDVALUE('Product_Select'[Code 8])",
              ")"
            ],
            "lineageTag": "a1a2a3a4-b5b6-7890-cdef-111111111101"
          },
          {
            "name": "Scenario_Context_Code_Packing",
            "expression": [
              "",
              "COALESCE(",
              "    SELECTEDVALUE('Product Category'[Code Packing]),",
              "    SELECTEDVALUE('Product_Select'[Code Packing])",
              ")"
            ],
            "lineageTag": "a1a2a3a4-b5b6-7890-cdef-111111111102"
          },
          {
            "name": "Scenario_Context_Density",
            "expression": [
              "",
              "COALESCE(",
              "    SELECTEDVALUE('Product Category'[Density @15]),",
              "    SELECTEDVALUE('Product_Select'[Density @15])",
              ")"
            ],
            "lineageTag": "a1a2a3a4-b5b6-7890-cdef-111111111103"
          },
          {
            "name": "Demand_Additive_Scenario_KG",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ],
            "expression": [
              "",
              "VAR _Original_Demand = [Demand_Additive_From_Production_KG]",
              "VAR _Scenario_Date = SELECTEDVALUE('Scenario_Date'[Date])",
              "VAR _Scenario_Pack_Qty = [Scenario_Qty Value] ",
              "",
              "VAR _Selected_Code8 = [Scenario_Context_Code8]",
              "VAR _Selected_Code_Packing = [Scenario_Context_Code_Packing]",
              "VAR _Density = [Scenario_Context_Density]",
              "",
              "VAR _Pack_KL = ",
              "    CALCULATE(",
              "        MAX('Code Packing'[KL]), ",
              "        'Code Packing'[Code packing] = _Selected_Code_Packing",
              "    )",
              "",
              "-- SỬA TẠI ĐÂY: Nhân thêm 1000 vì _Pack_KL của phuy 200L đang để là 0.2 m3 (Kiloliter)",
              "VAR _Scenario_Qty_Change_KG = _Scenario_Pack_Qty * (_Pack_KL * 1000 * _Density) ",
              "",
              "VAR _Additives_Of_Selected = CALCULATETABLE(VALUES('BOM'[Code 8 Material]), REMOVEFILTERS('BOM'), 'BOM'[Code 8] = _Selected_Code8)",
              "VAR _Current_Chart_Additive = MAX('BOM'[Code 8 Material])",
              "",
              "VAR _Current_Additive_Percentage = ",
              "    CALCULATE(",
              "        MAX('BOM'[ (%)]) / 1000, -- SỬA TẠI ĐÂY: Chia 1000 thay vì chia 100 để ra đúng tỷ lệ thực tế",
              "        ALL('BOM'),",
              "        'BOM'[Code 8] = _Selected_Code8,",
              "        'BOM'[Code 8 Material] = _Current_Chart_Additive",
              "    )",
              "",
              "RETURN",
              "    IF(",
              "        _Current_Chart_Additive IN _Additives_Of_Selected,",
              "        IF(",
              "            ISBLANK(_Scenario_Date),",
              "            BLANK(),",
              "            IF (",
              "                MAX('Calendar'[Date]) = _Scenario_Date,",
              "                (_Scenario_Qty_Change_KG * _Current_Additive_Percentage), -- Chỉ lấy lượng tăng thêm",
              "                BLANK()",
              "            )",
              "        ),",
              "        BLANK()",
              "    )"
            ],
            "lineageTag": "c5fc705e-b6fa-4af2-808f-32166217c9ea"
          },
          {
            "name": "Stock_Additive_Scenario_luy_ke_KG",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ],
            "expression": [
              "",
              "VAR _Ngay_Dang_Xet = MAX('Calendar'[Date])",
              "VAR _Ngay_Goc = CALCULATE(MIN('Opening Stock'[To Date]), REMOVEFILTERS('Calendar'))",
              "VAR _Ton_Dau_Ky = CALCULATE([Total_Opening_Stock_KG], REMOVEFILTERS('Calendar'))",
              "",
              "VAR _Luy_Tien_Tau_Ve = ",
              "    CALCULATE(",
              "        [Total_incomming_KG],",
              "        FILTER(ALL('Calendar'), 'Calendar'[Date] >= _Ngay_Goc && 'Calendar'[Date] <= _Ngay_Dang_Xet)",
              "    )",
              "",
              "VAR _Luy_Tien_Tieu_Hao_Goc = ",
              "    CALCULATE(",
              "        [Demand_Additive_From_Production_KG],",
              "        FILTER(ALL('Calendar'), 'Calendar'[Date] >= _Ngay_Goc && 'Calendar'[Date] <= _Ngay_Dang_Xet)",
              "    )",
              "",
              "-- Thông số kịch bản từ Slicer độc lập",
              "VAR _Scenario_Date = SELECTEDVALUE('Scenario_Date'[Date])",
              "VAR _Scenario_Pack_Qty = [Scenario_Qty Value]",
              "",
              "VAR _Selected_Code8 = [Scenario_Context_Code8]",
              "VAR _Selected_Code_Packing = [Scenario_Context_Code_Packing]",
              "VAR _Density = [Scenario_Context_Density]",
              "",
              "-- Tra cứu dung tích KL của bao bì",
              "VAR _Pack_KL = ",
              "    CALCULATE(",
              "        MAX('Code Packing'[KL]), ",
              "        'Code Packing'[Code packing] = _Selected_Code_Packing",
              "    )",
              "",
              "-- Xác định danh sách mã phụ gia của sản phẩm được chọn",
              "VAR _Additives_Of_Selected = CALCULATETABLE(VALUES('BOM'[Code 8 Material]), REMOVEFILTERS('BOM'), 'BOM'[Code 8] = _Selected_Code8)",
              "VAR _Current_Chart_Additive = MAX('BOM'[Code 8 Material])",
              "",
              "-- Tính khối lượng bao bì và lượng phụ gia thay đổi chuẩn xác",
              "VAR _Kg_Per_Pack = _Pack_KL * 1000 * _Density -- SỬA TẠI ĐÂY: Nhân thêm 1000 giống như trên",
              "",
              "VAR _Current_Additive_Percentage = ",
              "    CALCULATE(",
              "        MAX('BOM'[ (%)]) / 1000, -- SỬA TẠI ĐÂY: Chia 1000 thay vì chia 100",
              "        ALL('BOM'),",
              "        'BOM'[Code 8] = _Selected_Code8,",
              "        'BOM'[Code 8 Material] = _Current_Chart_Additive",
              "    )",
              "",
              "VAR _Scenario_Qty_Change_KG = _Scenario_Pack_Qty * _Kg_Per_Pack",
              "VAR _Additive_Change_KG = _Scenario_Qty_Change_KG * _Current_Additive_Percentage",
              "",
              "VAR _Luy_Ke_Thay_Doi = ",
              "    IF(_Ngay_Dang_Xet >= _Scenario_Date && _Scenario_Date >= _Ngay_Goc, _Additive_Change_KG, 0)",
              "",
              "RETURN",
              "    IF(",
              "        _Current_Chart_Additive IN _Additives_Of_Selected,",
              "        IF(",
              "            _Ngay_Dang_Xet < _Ngay_Goc,",
              "            BLANK(),",
              "            _Ton_Dau_Ky + _Luy_Tien_Tau_Ve - (_Luy_Tien_Tieu_Hao_Goc + _Luy_Ke_Thay_Doi)",
              "        ),",
              "        BLANK()",
              "    )"
            ],
            "lineageTag": "5783b4a0-a49f-43ce-b752-9c153a6231cf"
          },
          {
            "name": "Max_Axis_Value_Scenario",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ],
            "expression": [
              "",
              "-- 1. Lấy danh sách các ngày đang hiển thị trong bộ lọc hiện tại trên trang",
              "VAR _Danh_Sach_Ngay = ALLSELECTED('Calendar'[Date])",
              "",
              "-- 2. Tạo một bảng lọc chỉ giữ lại những ngày thực sự có đường xu hướng tồn kho hiển thị (không trống)",
              "VAR _Bang_Ngay_Thuc_Te = ",
              "    FILTER(",
              "        _Danh_Sach_Ngay,",
              "        NOT(ISBLANK([Stock_Additive_luy_ke_KG]))",
              "    )",
              "",
              "-- 3. Tìm giá trị lớn nhất của đường và cột dựa trên các ngày thực tế hiển thị trên màn hình",
              "VAR _Max_Means = MAXX(_Bang_Ngay_Thuc_Te, CALCULATE(SUM('PO list'[Means (KG)])))",
              "VAR _Max_Demand = MAXX(_Bang_Ngay_Thuc_Te, [Demand_Additive_From_Production_KG])",
              "VAR _Max_Demand_Scen = MAXX(_Bang_Ngay_Thuc_Te, [Demand_Additive_Scenario_KG])",
              "VAR _Max_Stock = MAXX(_Bang_Ngay_Thuc_Te, [Stock_Additive_luy_ke_KG])",
              "VAR _Max_Stock_Scen = MAXX(_Bang_Ngay_Thuc_Te, [Stock_Additive_Scenario_luy_ke_KG])",
              "",
              "-- 4. Xác định đỉnh cao nhất tuyệt đối hiển thị trên màn hình",
              "VAR _Max_Tuyet_Doi = MAX(MAX(MAX(MAX(_Max_Means, _Max_Demand), _Max_Demand_Scen), _Max_Stock), _Max_Stock_Scen)",
              "",
              "-- 5. Trả về kết quả cộng thêm 10% khoảng trống trần đồ thị cho đẹp",
              "RETURN ",
              "    IF(ISBLANK(_Max_Tuyet_Doi), BLANK(), _Max_Tuyet_Doi * 1.1)"
            ],
            "lineageTag": "204544d9-85b6-40f8-9b4a-424cdf42fc09"
          },
          {
            "name": "Filter_San_Pham_Dung_Chung",
            "expression": [
              "",
              "-- Tìm danh sách các phụ gia (Material name) thuộc sản phẩm đang chọn ở Slicer",
              "VAR _Danh_Sach_Phu_Gia = CALCULATETABLE(VALUES('BOM'[Material name]), ALL('Product Category'))",
              "",
              "-- Kiểm tra xem các sản phẩm khác trong bảng có chứa các phụ gia này không",
              "VAR _Kiem_Tra = CALCULATE(COUNTROWS('BOM'), REMOVEFILTERS('Product Category'), 'BOM'[Material name] IN _Danh_Sach_Phu_Gia)",
              "",
              "RETURN ",
              "    IF(_Kiem_Tra > 0, 1, 0)"
            ],
            "formatString": "0",
            "lineageTag": "3320cc8c-aea4-4555-989f-db18eb6a6b47"
          },
          {
            "name": "Filter_Table2_Additives",
            "expression": [
              "",
              "VAR _Selected_Code8 = SELECTEDVALUE('Product_Select'[Code 8])",
              "VAR _Material = MAX('BOM'[Material name])",
              "RETURN",
              "    IF(",
              "        ISBLANK(_Selected_Code8) || ISBLANK(_Material),",
              "        BLANK(),",
              "        IF(",
              "            CALCULATE(",
              "                COUNTROWS('BOM'),",
              "                REMOVEFILTERS('BOM'),",
              "                'BOM'[Code 8] = _Selected_Code8,",
              "                'BOM'[Material name] = _Material",
              "            ) > 0,",
              "            1,",
              "            BLANK()",
              "        )",
              "    )"
            ],
            "formatString": "0",
            "lineageTag": "ffa84c8a-7dd3-4e20-b38d-437a6034d742"
          },
          {
            "name": "Filter_Table3_Related_Products",
            "expression": [
              "",
              "",
              "VAR _Selected_Code8 = SELECTEDVALUE('Product_Select'[Code 8])",
              "VAR _Current_Row_Code8 = MAX('Product Category'[Code 8])",
              "",
              "-- kiểm tra có click phụ gia không",
              "VAR _Selected_Additive = SELECTEDVALUE('BOM'[Code 8 Material])",
              "",
              "RETURN",
              "IF(",
              "    MAX('Product Category'[Material Code]) <> SELECTEDVALUE('Product_Select'[Material Code]),",
              "",
              "    IF(",
              "        NOT(ISBLANK(_Selected_Additive)),",
              "",
              "        -- CASE 1: ĐÃ CLICK phụ gia → lọc trực tiếp theo phụ gia",
              "        IF(",
              "            CALCULATE(",
              "                COUNTROWS('BOM'),",
              "                REMOVEFILTERS('BOM'), -- <--- THÊM DUY NHẤT DÒNG NÀY ĐỂ XOÁ BẪY CROSS-FILTER",
              "                'BOM'[Code 8] = _Current_Row_Code8,",
              "                'BOM'[Code 8 Material] = _Selected_Additive",
              "            ) > 0,",
              "            1,",
              "            BLANK()",
              "        ),",
              "",
              "        -- CASE 2: KHÔNG CLICK → dùng logic intersect (Đoạn này của bạn rất chuẩn rồi)",
              "        VAR _Additives_Of_Selected_Product = ",
              "            CALCULATETABLE(",
              "                VALUES('BOM'[Code 8 Material]),",
              "                REMOVEFILTERS('BOM'),",
              "                'BOM'[Code 8] = _Selected_Code8",
              "            )",
              "",
              "        VAR _Additives_Of_Current_Row = ",
              "            CALCULATETABLE(",
              "                VALUES('BOM'[Code 8 Material]),",
              "                REMOVEFILTERS('BOM'),",
              "                'BOM'[Code 8] = _Current_Row_Code8",
              "            )",
              "",
              "        VAR _Shared_Additives = ",
              "            INTERSECT(_Additives_Of_Selected_Product, _Additives_Of_Current_Row)",
              "",
              "        RETURN IF(NOT(ISEMPTY(_Shared_Additives)), 1, BLANK())",
              "    ),",
              "",
              "    BLANK()",
              ")"
            ],
            "formatString": "0",
            "lineageTag": "6cccfa71-258d-472b-ba75-e3a9c5252d59"
          },
          {
            "name": "Filter_Bảng_Phụ_Gia",
            "expression": [
              "",
              "VAR _Selected_Code8 = SELECTEDVALUE('Product_Select'[Code 8])",
              "",
              "-- Lấy danh sách tất cả các mã sản phẩm (Code 8) có sử dụng loại phụ gia đang xét ở dòng này",
              "VAR _Products_Of_This_Additive = CALCULATETABLE(VALUES('BOM'[Code 8]), REMOVEFILTERS('Product_Select'))",
              "",
              "RETURN",
              "    -- Nếu sản phẩm đang chọn trên Slicer nằm trong danh sách các sản phẩm sử dụng loại phụ gia này thì giữ lại",
              "    IF(_Selected_Code8 IN _Products_Of_This_Additive, 1, BLANK())"
            ],
            "formatString": "0",
            "lineageTag": "fb4ffa0f-7ac6-475e-ab10-f0c1ddbb0854"
          },
          {
            "name": "Color_Product_Has_Plan",
            "expression": [
              "",
              "-- Tính tổng sản lượng sản xuất của sản phẩm đó từ NGÀY HÔM NAY trở về sau",
              "VAR _Total_KG_Plan_Future = ",
              "    CALCULATE(",
              "        SUM('Production Plan'[KG]),",
              "        'Production Plan'[Date] >= TODAY() -- Lọc chỉ lấy ngày lớn hơn hoặc bằng ngày hôm nay",
              "    )",
              "",
              "RETURN",
              "    IF(",
              "        _Total_KG_Plan_Future > 0,",
              "        \"#D4EDDA\", -- Tô màu Xanh lá nhạt nếu có lịch chạy trong tương lai/hôm nay",
              "        BLANK()    -- Để trống (màu trắng) nếu chỉ có lịch quá khứ hoặc không có lịch",
              "    )"
            ],
            "lineageTag": "2417d088-c432-4e0e-ab08-fd8d5701bd26"
          },
          {
            "name": "Monthly_FC_Demand_Additive_KG",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ],
            "expression": [
              "",
              "VAR _SelectedMonth =",
              "    COALESCE(",
              "        SELECTEDVALUE('FC Period Select'[Month FC]),",
              "        DATE(YEAR(TODAY()), MONTH(TODAY()), 1)",
              "    )",
              "RETURN",
              "    CALCULATE(",
              "        [Demand_additive_KG],",
              "        REMOVEFILTERS('Product_Select'),",
              "        REMOVEFILTERS('Product Category'),",
              "        REMOVEFILTERS(FC),",
              "        TREATAS({_SelectedMonth}, FC[Month FC])",
              "    )"
            ],
            "lineageTag": "a1b2c3d4-e5f6-7890-abcd-ef1234567890"
          },
          {
            "name": "Stock_Level_Months_FC",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ],
            "expression": [
              "",
              "VAR _Stock =",
              "    CALCULATE(",
              "        [Stock_Additive_luy_ke_KG],",
              "        REMOVEFILTERS('Product_Select'),",
              "        REMOVEFILTERS('Product Category')",
              "    )",
              "VAR _MonthlyDemand = [Monthly_Demand_Additive_KG]",
              "VAR _Level = DIVIDE(_Stock, _MonthlyDemand, BLANK())",
              "RETURN",
              "    IF(",
              "        ISBLANK(_Level) || _MonthlyDemand <= 0,",
              "        BLANK(),",
              "        MIN(_Level, 48)",
              "    )"
            ],
            "formatString": "0.0",
            "lineageTag": "b2c3d4e5-f6a7-8901-bcde-f12345678901"
          },
          {
            "name": "Max_Stock_Level_Months_FC",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ],
            "expression": [
              "",
              "VAR _Dates = VALUES('Calendar'[Date])",
              "RETURN",
              "    MAXX(_Dates, [Stock_Level_Months_FC]) * 1.1"
            ],
            "lineageTag": "c3d4e5f6-a7b8-9012-cdef-123456789012"
          },
          {
            "name": "Filter_Product_BOM_Additive",
            "expression": [
              "",
              "VAR _Selected_Code8 = SELECTEDVALUE('Product_Select'[Code 8])",
              "VAR _Selected_Product = SELECTEDVALUE('Product_Select'[Product Name])",
              "VAR _MaterialName = SELECTEDVALUE('BOM'[Material name])",
              "RETURN",
              "    IF(",
              "        ISBLANK(_MaterialName) || (ISBLANK(_Selected_Code8) && ISBLANK(_Selected_Product)),",
              "        BLANK(),",
              "        IF(",
              "            CALCULATE(",
              "                COUNTROWS('BOM'),",
              "                REMOVEFILTERS('BOM'),",
              "                REMOVEFILTERS('Product_Select'),",
              "                'BOM'[Material name] = _MaterialName,",
              "                'BOM'[Code 8] = _Selected_Code8 || 'BOM'[Product] = _Selected_Product",
              "            ) > 0,",
              "            1,",
              "            BLANK()",
              "        )",
              "    )"
            ],
            "formatString": "0",
            "lineageTag": "a7b8c9d0-e1f2-3456-abcd-789012345678"
          },
          {
            "name": "Monthly_Actual_Usage_Additive_KG",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ],
            "expression": [
              "",
              "VAR _PrevMonthStart = EDATE(DATE(YEAR(TODAY()), MONTH(TODAY()), 1), -1)",
              "VAR _PrevMonthEnd = EOMONTH(_PrevMonthStart)",
              "RETURN",
              "    CALCULATE(",
              "        [Demand_Additive_From_Production_KG],",
              "        REMOVEFILTERS('Calendar'),",
              "        FILTER(",
              "            ALL('Calendar'[Date]),",
              "            'Calendar'[Date] >= _PrevMonthStart && 'Calendar'[Date] <= _PrevMonthEnd",
              "        )",
              "    )"
            ],
            "lineageTag": "b8c9d0e1-f2a3-4567-bcde-890123456789"
          },
          {
            "name": "Monthly_Demand_Additive_KG",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ],
            "expression": [
              "",
              "VAR _DemandSource = SELECTEDVALUE('FC Period Select'[Demand Source], \"FC\")",
              "VAR _FCDemand = [Monthly_FC_Demand_Additive_KG]",
              "VAR _ActualDemand = [Monthly_Actual_Usage_Additive_KG]",
              "RETURN",
              "    SWITCH(",
              "        _DemandSource,",
              "        \"Actual\", _ActualDemand,",
              "        IF(_FCDemand > 0, _FCDemand, _ActualDemand)",
              "    )"
            ],
            "lineageTag": "c9d0e1f2-a3b4-5678-cdef-901234567890"
          },
          {
            "name": "Monthly_FC_Demand_Additive_KG_Product",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ],
            "expression": [
              "",
              "VAR _SelectedMonth =",
              "    COALESCE(",
              "        SELECTEDVALUE('FC Period Select'[Month FC]),",
              "        DATE(YEAR(TODAY()), MONTH(TODAY()), 1)",
              "    )",
              "VAR _Code8 = SELECTEDVALUE('Product_Select'[Code 8])",
              "VAR _ProductName = SELECTEDVALUE('Product_Select'[Product Name])",
              "RETURN",
              "    IF(",
              "        ISBLANK(_Code8) && ISBLANK(_ProductName),",
              "        BLANK(),",
              "        CALCULATE(",
              "            SUMX(",
              "                FILTER(",
              "                    BOM,",
              "                    BOM[Code 8] = _Code8 || BOM[Product] = _ProductName",
              "                ),",
              "                [Total_FC_KG] * BOM[ (%)] / 1000",
              "            ),",
              "            REMOVEFILTERS(FC),",
              "            REMOVEFILTERS('Product_Select'),",
              "            REMOVEFILTERS('Product Category'),",
              "            TREATAS({_SelectedMonth}, FC[Month FC])",
              "        )",
              "    )"
            ],
            "lineageTag": "d4e5f6a7-b8c9-0123-defa-456789012345"
          },
          {
            "name": "Monthly_Actual_Usage_Additive_KG_Product",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ],
            "expression": [
              "",
              "VAR _Code8 = SELECTEDVALUE('Product_Select'[Code 8])",
              "VAR _ProductName = SELECTEDVALUE('Product_Select'[Product Name])",
              "VAR _PrevMonthStart = EDATE(DATE(YEAR(TODAY()), MONTH(TODAY()), 1), -1)",
              "VAR _PrevMonthEnd = EOMONTH(_PrevMonthStart)",
              "RETURN",
              "    IF(",
              "        ISBLANK(_Code8) && ISBLANK(_ProductName),",
              "        BLANK(),",
              "        CALCULATE(",
              "            [Demand_Additive_From_Production_KG],",
              "            REMOVEFILTERS('Calendar'),",
              "            REMOVEFILTERS('Product_Select'),",
              "            REMOVEFILTERS('Product Category'),",
              "            FILTER(",
              "                ALL('Calendar'[Date]),",
              "                'Calendar'[Date] >= _PrevMonthStart && 'Calendar'[Date] <= _PrevMonthEnd",
              "            ),",
              "            'Product Category'[Code 8] = _Code8 || 'Product Category'[Product Name] = _ProductName",
              "        )",
              "    )"
            ],
            "lineageTag": "d0e1f2a3-b4c5-6789-defa-012345678901"
          },
          {
            "name": "Monthly_Demand_Additive_KG_Product",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ],
            "expression": [
              "",
              "VAR _DemandSource = SELECTEDVALUE('FC Period Select'[Demand Source], \"FC\")",
              "VAR _Code8 = SELECTEDVALUE('Product_Select'[Code 8])",
              "VAR _ProductName = SELECTEDVALUE('Product_Select'[Product Name])",
              "VAR _FCDemand = [Monthly_FC_Demand_Additive_KG_Product]",
              "VAR _ActualDemand = [Monthly_Actual_Usage_Additive_KG_Product]",
              "RETURN",
              "    IF(",
              "        ISBLANK(_Code8) && ISBLANK(_ProductName),",
              "        BLANK(),",
              "        SWITCH(",
              "            _DemandSource,",
              "            \"Actual\", _ActualDemand,",
              "            IF(_FCDemand > 0, _FCDemand, _ActualDemand)",
              "        )",
              "    )"
            ],
            "lineageTag": "e1f2a3b4-c5d6-7890-abcd-123456789012"
          },
          {
            "name": "Stock_Level_Months_FC_Product",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ],
            "expression": [
              "",
              "VAR _Code8 = SELECTEDVALUE('Product_Select'[Code 8])",
              "VAR _ProductName = SELECTEDVALUE('Product_Select'[Product Name])",
              "VAR _Stock =",
              "    CALCULATE(",
              "        [Stock_Additive_luy_ke_KG],",
              "        REMOVEFILTERS('Product_Select'),",
              "        REMOVEFILTERS('Product Category')",
              "    )",
              "VAR _MonthlyDemand = [Monthly_Demand_Additive_KG_Product]",
              "VAR _Level = DIVIDE(_Stock, _MonthlyDemand, BLANK())",
              "RETURN",
              "    IF(",
              "        (ISBLANK(_Code8) && ISBLANK(_ProductName)) || ISBLANK(_Level) || _MonthlyDemand <= 0,",
              "        BLANK(),",
              "        MIN(_Level, 48)",
              "    )"
            ],
            "formatString": "0.0",
            "lineageTag": "e5f6a7b8-c9d0-1234-efab-567890123456"
          },
          {
            "name": "Max_Stock_Level_Months_FC_Product",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ],
            "expression": [
              "",
              "VAR _Dates = VALUES('Calendar'[Date])",
              "RETURN",
              "    MAXX(_Dates, [Stock_Level_Months_FC_Product]) * 1.1"
            ],
            "lineageTag": "f6a7b8c9-d0e1-2345-fabc-678901234567"
          },
          {
            "name": "Monthly_FC_Demand_Additive_KG_NextMonth",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ],
            "expression": [
              "",
              "VAR _NextMonth = EDATE(DATE(YEAR(TODAY()), MONTH(TODAY()), 1), 1)",
              "VAR _Material = MAX('BOM'[Material name])",
              "RETURN",
              "    IF(",
              "        ISBLANK(_Material),",
              "        BLANK(),",
              "        SUMX(",
              "            FILTER(ALL(BOM), BOM[Material name] = _Material),",
              "            VAR _Code8 = BOM[Code 8]",
              "            VAR _Pct = BOM[ (%)]",
              "            VAR _ProductFC_KG =",
              "                CALCULATE(",
              "                    [Total_FC_KG],",
              "                    REMOVEFILTERS(FC),",
              "                    REMOVEFILTERS('Product_Select'),",
              "                    REMOVEFILTERS('Product Category'),",
              "                    TREATAS({_NextMonth}, FC[Month FC]),",
              "                    TREATAS({_Code8}, 'Product Category'[Code 8])",
              "                )",
              "            RETURN DIVIDE(_ProductFC_KG * _Pct, 1000, 0)",
              "        )",
              "    )"
            ],
            "lineageTag": "a1b2c3d4-e5f6-7890-abcd-ef1234567891"
          },
          {
            "name": "Stock_Level_Months_FC_NextMonth",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ],
            "expression": [
              "",
              "VAR _Stock = [Stock_Additive_luy_ke_KG]",
              "VAR _MonthlyDemand = [Monthly_FC_Demand_Additive_KG_NextMonth]",
              "VAR _Level = DIVIDE(_Stock, _MonthlyDemand, BLANK())",
              "RETURN",
              "    IF(",
              "        ISBLANK(_Level) || _MonthlyDemand <= 0,",
              "        BLANK(),",
              "        _Level",
              "    )"
            ],
            "formatString": "0.0",
            "lineageTag": "b2c3d4e5-f6a7-8901-bcde-f1234567892"
          },
          {
            "name": "Stock_Level_Months_FC_NextMonth_Scenario",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ],
            "expression": [
              "",
              "VAR _Stock = [Stock_Additive_Scenario_luy_ke_KG]",
              "VAR _MonthlyDemand = [Monthly_FC_Demand_Additive_KG_NextMonth]",
              "VAR _Level = DIVIDE(_Stock, _MonthlyDemand, BLANK())",
              "RETURN",
              "    IF(",
              "        ISBLANK(_Level) || _MonthlyDemand <= 0,",
              "        BLANK(),",
              "        _Level",
              "    )"
            ],
            "formatString": "0.0",
            "lineageTag": "d4e5f6a7-b8c9-0123-defa-456789012346"
          },
          {
            "name": "Stock_Level_Months_FC_NextMonth_Chart",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ],
            "expression": [
              "",
              "VAR _Show = [Filter_Table2_Additives]",
              "VAR _ScenarioQty = [Scenario_Qty Value]",
              "VAR _ScenarioDate = SELECTEDVALUE('Scenario_Date'[Date])",
              "VAR _CurrentDate = MAX('Calendar'[Date])",
              "VAR _Actual = [Stock_Level_Months_FC_NextMonth]",
              "VAR _Scenario = [Stock_Level_Months_FC_NextMonth_Scenario]",
              "VAR _Value =",
              "    IF(",
              "        _ScenarioQty > 0 && NOT(ISBLANK(_ScenarioDate)) && _CurrentDate >= _ScenarioDate,",
              "        COALESCE(_Scenario, _Actual),",
              "        _Actual",
              "    )",
              "RETURN",
              "    IF(_Show = 1, _Value, BLANK())"
            ],
            "formatString": "0.0",
            "lineageTag": "e5f6a7b8-c9d0-1234-efab-567890123457"
          },
          {
            "name": "Stock_Additive_Scenario_Slicer_KG",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ],
            "expression": [
              "",
              "VAR _Ngay_Dang_Xet = MAX('Calendar'[Date])",
              "VAR _Ngay_Goc = CALCULATE(MIN('Opening Stock'[To Date]), REMOVEFILTERS('Calendar'))",
              "VAR _Ton_Dau_Ky = CALCULATE([Total_Opening_Stock_KG], REMOVEFILTERS('Calendar'))",
              "VAR _Luy_Tien_Tau_Ve = ",
              "    CALCULATE(",
              "        [Total_incomming_KG],",
              "        FILTER(ALL('Calendar'), 'Calendar'[Date] >= _Ngay_Goc && 'Calendar'[Date] <= _Ngay_Dang_Xet)",
              "    )",
              "VAR _Luy_Tien_Tieu_Hao_Goc = ",
              "    CALCULATE(",
              "        [Demand_Additive_From_Production_KG],",
              "        FILTER(ALL('Calendar'), 'Calendar'[Date] >= _Ngay_Goc && 'Calendar'[Date] <= _Ngay_Dang_Xet)",
              "    )",
              "VAR _Scenario_Date = SELECTEDVALUE('Scenario_Date'[Date])",
              "VAR _Scenario_Pack_Qty = [Scenario_Qty Value]",
              "VAR _Selected_Code8 = SELECTEDVALUE('Product_Select'[Code 8])",
              "VAR _Selected_Code_Packing = SELECTEDVALUE('Product_Select'[Code Packing])",
              "VAR _Density = SELECTEDVALUE('Product_Select'[Density @15])",
              "VAR _Pack_KL = ",
              "    CALCULATE(",
              "        MAX('Code Packing'[KL]), ",
              "        'Code Packing'[Code packing] = _Selected_Code_Packing",
              "    )",
              "VAR _Additives_Of_Selected = CALCULATETABLE(VALUES('BOM'[Code 8 Material]), REMOVEFILTERS('BOM'), 'BOM'[Code 8] = _Selected_Code8)",
              "VAR _Current_Chart_Additive = MAX('BOM'[Code 8 Material])",
              "VAR _Kg_Per_Pack = _Pack_KL * 1000 * _Density",
              "VAR _Current_Additive_Percentage = ",
              "    CALCULATE(",
              "        MAX('BOM'[ (%)]) / 1000,",
              "        ALL('BOM'),",
              "        'BOM'[Code 8] = _Selected_Code8,",
              "        'BOM'[Code 8 Material] = _Current_Chart_Additive",
              "    )",
              "VAR _Scenario_Qty_Change_KG = _Scenario_Pack_Qty * _Kg_Per_Pack",
              "VAR _Additive_Change_KG = _Scenario_Qty_Change_KG * _Current_Additive_Percentage",
              "VAR _Luy_Ke_Thay_Doi = ",
              "    IF(_Ngay_Dang_Xet >= _Scenario_Date && _Scenario_Date >= _Ngay_Goc, _Additive_Change_KG, 0)",
              "RETURN",
              "    IF(",
              "        ISBLANK(_Selected_Code8),",
              "        BLANK(),",
              "        IF(",
              "            _Current_Chart_Additive IN _Additives_Of_Selected,",
              "            IF(",
              "                _Ngay_Dang_Xet < _Ngay_Goc,",
              "                BLANK(),",
              "                _Ton_Dau_Ky + _Luy_Tien_Tau_Ve - (_Luy_Tien_Tieu_Hao_Goc + _Luy_Ke_Thay_Doi)",
              "            ),",
              "            BLANK()",
              "        )",
              "    )"
            ],
            "lineageTag": "b1c2d3e4-f5a6-7890-abcd-ef123456789a"
          },
          {
            "name": "Stock_Additive_Scenario_Table_KG",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ],
            "expression": [
              "",
              "VAR _Ngay_Dang_Xet = MAX('Calendar'[Date])",
              "VAR _Ngay_Goc = CALCULATE(MIN('Opening Stock'[To Date]), REMOVEFILTERS('Calendar'))",
              "VAR _Ton_Dau_Ky = CALCULATE([Total_Opening_Stock_KG], REMOVEFILTERS('Calendar'))",
              "VAR _Luy_Tien_Tau_Ve = ",
              "    CALCULATE(",
              "        [Total_incomming_KG],",
              "        FILTER(ALL('Calendar'), 'Calendar'[Date] >= _Ngay_Goc && 'Calendar'[Date] <= _Ngay_Dang_Xet)",
              "    )",
              "VAR _Luy_Tien_Tieu_Hao_Goc = ",
              "    CALCULATE(",
              "        [Demand_Additive_From_Production_KG],",
              "        FILTER(ALL('Calendar'), 'Calendar'[Date] >= _Ngay_Goc && 'Calendar'[Date] <= _Ngay_Dang_Xet)",
              "    )",
              "VAR _Scenario_Date = SELECTEDVALUE('Scenario_Date'[Date])",
              "VAR _Scenario_Pack_Qty = [Scenario_Qty Value]",
              "VAR _Selected_Code8 = SELECTEDVALUE('Product Category'[Code 8])",
              "VAR _Selected_Code_Packing = SELECTEDVALUE('Product Category'[Code Packing])",
              "VAR _Density = SELECTEDVALUE('Product Category'[Density @15])",
              "VAR _Pack_KL = ",
              "    CALCULATE(",
              "        MAX('Code Packing'[KL]), ",
              "        'Code Packing'[Code packing] = _Selected_Code_Packing",
              "    )",
              "VAR _Additives_Of_Selected = CALCULATETABLE(VALUES('BOM'[Code 8 Material]), REMOVEFILTERS('BOM'), 'BOM'[Code 8] = _Selected_Code8)",
              "VAR _Current_Chart_Additive = MAX('BOM'[Code 8 Material])",
              "VAR _Kg_Per_Pack = _Pack_KL * 1000 * _Density",
              "VAR _Current_Additive_Percentage = ",
              "    CALCULATE(",
              "        MAX('BOM'[ (%)]) / 1000,",
              "        ALL('BOM'),",
              "        'BOM'[Code 8] = _Selected_Code8,",
              "        'BOM'[Code 8 Material] = _Current_Chart_Additive",
              "    )",
              "VAR _Scenario_Qty_Change_KG = _Scenario_Pack_Qty * _Kg_Per_Pack",
              "VAR _Additive_Change_KG = _Scenario_Qty_Change_KG * _Current_Additive_Percentage",
              "VAR _Luy_Ke_Thay_Doi = ",
              "    IF(_Ngay_Dang_Xet >= _Scenario_Date && _Scenario_Date >= _Ngay_Goc, _Additive_Change_KG, 0)",
              "RETURN",
              "    IF(",
              "        ISBLANK(_Selected_Code8),",
              "        BLANK(),",
              "        IF(",
              "            _Current_Chart_Additive IN _Additives_Of_Selected,",
              "            IF(",
              "                _Ngay_Dang_Xet < _Ngay_Goc,",
              "                BLANK(),",
              "                _Ton_Dau_Ky + _Luy_Tien_Tau_Ve - (_Luy_Tien_Tieu_Hao_Goc + _Luy_Ke_Thay_Doi)",
              "            ),",
              "            BLANK()",
              "        )",
              "    )"
            ],
            "lineageTag": "b1c2d3e4-f5a6-7890-abcd-ef123456789b"
          },
