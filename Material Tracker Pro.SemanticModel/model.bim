                "    #\"PC_Changed Type\" = Table.TransformColumnTypes(#\"PC_Promoted Headers\",{{\"Category \", type text}, {\"Material Code\", type text}, {\"Product Name\", type text}, {\"Code 8\", type text}}),",
                "    #\"PC_Duplicated Column\" = Table.DuplicateColumn(#\"PC_Changed Type\", \"Material Code\", \"Material Code - Copy\"),",
                "    #\"PC_Inserted Text Range\" = Table.AddColumn(#\"PC_Duplicated Column\", \"Text Range\", each Text.Middle([#\"Material Code - Copy\"], 9, 3), type text),",
                "    #\"PC_Removed Columns\" = Table.RemoveColumns(#\"PC_Inserted Text Range\",{\"Material Code - Copy\"}),",
                "    PC_Table = Table.RenameColumns(#\"PC_Removed Columns\",{{\"Text Range\", \"Code Packing\"}}),",
                "    CodePacking = Table.TransformColumnTypes(Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText(\"\", BinaryEncoding.Base64), Compression.Deflate)), let _t = ((type nullable text) meta [Serialized.Text = true]) in type table [#\"Code packing\" = _t, KL = _t, #\"Name packing\" = _t]),{{\"Code packing\", type text}, {\"KL\", type number}, {\"Name packing\", type text}}),",
                "    Dim_Source = Excel.Workbook(File.Contents(\"D:\\Box\\05. Supply Chain Management\\1. SCM (Planning)\\PowerBI\\Code LV.xlsx\"), null, true),",
                "    #\"Dim_Density Sheet\" = Dim_Source{[Item=\"Density-8digital code\",Kind=\"Sheet\"]}[Data],",
                "    #\"Dim_Promoted Headers\" = Table.PromoteHeaders(#\"Dim_Density Sheet\", [PromoteAllScalars=true]),",
                "    #\"Dim_Changed Type\" = Table.TransformColumnTypes(#\"Dim_Promoted Headers\",{{\"LV-Code\", type text}, {\"Re-blend of \", type text}, {\"SAP code\", type text}, {\"Product Name\", type text}, {\"Density @15\", type number}}),",
                "    Dim_BangGocSAP = Table.SelectColumns(#\"Dim_Changed Type\",{\"LV-Code\", \"SAP code\"}),",
                "    #\"Dim_Merged Queries\" = Table.NestedJoin(#\"Dim_Changed Type\", {\"Re-blend of \"}, Dim_BangGocSAP, {\"LV-Code\"}, \"Dim_BangGocSAP\", JoinKind.LeftOuter),",
                "    #\"Dim_Expanded BangGocSAP\" = Table.ExpandTableColumn(#\"Dim_Merged Queries\", \"Dim_BangGocSAP\", {\"SAP code\"}, {\"SAP code.1\"}),",
                "    #\"Dim_Renamed Columns\" = Table.RenameColumns(#\"Dim_Expanded BangGocSAP\",{{\"SAP code.1\", \"SAP_Code_Gốc_Mượn\"}}),",
                "    #\"Dim_Added Custom\" = Table.AddColumn(#\"Dim_Renamed Columns\", \"Mã_Bulk_Chuẩn\", each if [#\"Re-blend of \"] = null or [#\"Re-blend of \"] = \"\" then Text.From([SAP code]) else Text.From([SAP_Code_Gốc_Mượn])),",
                "    DimMapping = Table.SelectColumns(Table.SelectRows(Table.RemoveColumns(#\"Dim_Added Custom\",{\"SAP_Code_Gốc_Mượn\"}), each ([Mã_Bulk_Chuẩn] <> null)),{\"SAP code\", \"Density @15\"}),",
                "    #\"Merged Queries\" = Table.NestedJoin(PC_Table, {\"Code Packing\"}, CodePacking, {\"Code packing\"}, \"Code Packing.1\", JoinKind.LeftOuter),",
                "    #\"Expanded Code Packing.1\" = Table.ExpandTableColumn(#\"Merged Queries\", \"Code Packing.1\", {\"KL\"}, {\"Base KL\"}),",
                "    #\"Merged Queries1\" = Table.NestedJoin(#\"Expanded Code Packing.1\", {\"Code 8\"}, DimMapping, {\"SAP code\"}, \"Dim_Mapping_Code\", JoinKind.LeftOuter),",
                "    #\"Expanded Dim_Mapping_Code\" = Table.ExpandTableColumn(#\"Merged Queries1\", \"Dim_Mapping_Code\", {\"Density @15\"}, {\"Density @15\"}),",
                "    #\"Added Custom\" = Table.AddColumn(#\"Expanded Dim_Mapping_Code\", \"Base Kg\", each [Base KL]*(if [#\"Density @15\"] = null or [#\"Density @15\"] = 0 then 0 else [#\"Density @15\"]))",
                "in",
                "    #\"Added Custom\""
              ],
              "type": "m"
            }
          }
