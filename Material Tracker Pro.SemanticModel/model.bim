        "lineageTag": "3129f803-5492-401d-80bb-e6e831eda747",
        "partitions": [
          {
            "name": "FC",
            "mode": "import",
            "source": {
              "expression": [
                "let",
                "    Source = Excel.Workbook(File.Contents(\"D:\\Box\\05. Supply Chain Management\\1. SCM (Planning)\\1. Mr Thang\\2. Plan\\Summary data.xlsm\"), null, true),",
                "    #\"Data Bi_Sheet\" = Source{[Item=\"Data Bi\",Kind=\"Sheet\"]}[Data],",
                "    #\"Changed Type\" = Table.TransformColumnTypes(#\"Data Bi_Sheet\",{{\"Column1\", type text}, {\"Column2\", type text}, {\"Column3\", type text}, {\"Column4\", type any}, {\"Column5\", type any}, {\"Column6\", type any}, {\"Column7\", type any}, {\"Column8\", type any}, {\"Column9\", type any}, {\"Column10\", type any}, {\"Column11\", type any}, {\"Column12\", type text}, {\"Column13\", type any}, {\"Column14\", type any}, {\"Column15\", type any}, {\"Column16\", type any}, {\"Column17\", type any}, {\"Column18\", Int64.Type}, {\"Column19\", Int64.Type}, {\"Column20\", type any}, {\"Column21\", type any}, {\"Column22\", type any}, {\"Column23\", type any}, {\"Column24\", type any}, {\"Column25\", type any}}),",
                "    #\"Removed Other Columns\" = Table.SelectColumns(#\"Changed Type\",{\"Column1\", \"Column2\", \"Column3\", \"Column5\", \"Column6\", \"Column14\"}),",
                "    #\"Promoted Headers\" = Table.PromoteHeaders(#\"Removed Other Columns\", [PromoteAllScalars=true]),",
                "    #\"Changed Type1\" = Table.TransformColumnTypes(#\"Promoted Headers\",{{\"Category \", type text}, {\"Material Code\", type text}, {\"Product Name\", type text}, {\"FC this month\", Int64.Type}, {\"FC next month\", Int64.Type}}),",
                "    #\"Unpivoted Other Columns\" = Table.UnpivotOtherColumns(#\"Changed Type1\", {\"Category \", \"Material Code\", \"Product Name\"}, \"Attribute\", \"Value\"),",
                "    #\"Renamed Columns\" = Table.RenameColumns(#\"Unpivoted Other Columns\",{{\"Attribute\", \"FC\"}}),",
                "    #\"Added Custom\" = Table.AddColumn(#\"Renamed Columns\", \"Month FC\", each let",
                "    Today = Date.From(DateTime.LocalNow()),",
                "    ThisMonthStart = Date.StartOfMonth(Today),",
                "    NextMonthStart = Date.AddMonths(ThisMonthStart, 1),",
                "    MonthAfterNextStart = Date.AddMonths(ThisMonthStart, 2)",
                "in",
                "    if [FC] = \"FC this month\" then ThisMonthStart",
                "    else if [FC] = \"FC next month\" then NextMonthStart",
                "    else MonthAfterNextStart),",
                "    #\"Changed Type2\" = Table.TransformColumnTypes(#\"Added Custom\",{{\"Month FC\", type date}}),",
                "    #\"Removed Columns\" = Table.RemoveColumns(#\"Changed Type2\",{\"FC\"})",
                "in",
                "    #\"Removed Columns\""
              ],
              "type": "m"
            }
          }
        ]
      },
      {
