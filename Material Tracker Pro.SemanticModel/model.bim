        "lineageTag": "aef96c5b-cdca-4099-b97a-fa72e1cb060d",
        "partitions": [
          {
            "name": "Opening Stock",
            "mode": "import",
            "source": {
              "expression": [
                "let",
                "    UoM_Source = Excel.Workbook(File.Contents(\"D:\\Box\\05. Supply Chain Management\\1. SCM (Planning)\\PowerBI\\UoM Additive.xlsx\"), null, true),",
                "    #\"UoM_Sheet\" = UoM_Source{[Item=\"Stk 28.04\",Kind=\"Sheet\"]}[Data],",
                "    #\"UoM_Promoted\" = Table.PromoteHeaders(#\"UoM_Sheet\", [PromoteAllScalars=true]),",
                "    #\"UoM_Typed\" = Table.TransformColumnTypes(#\"UoM_Promoted\",{{\"Material\", type text}, {\"Material Description\", type text}, {\"Code 8\", Int64.Type}, {\"Base\", type number}}),",
                "    #\"UoM_Filtered1\" = Table.SelectRows(#\"UoM_Typed\", each [Material] <> null and [Material] <> \"\"),",
                "    UoMTable = Table.TransformColumnTypes(#\"UoM_Filtered1\",{{\"Code 8\", type text}, {\"Base\", type number}}),",
                "    Source = Excel.Workbook(File.Contents(\"D:\\Box\\05. Supply Chain Management\\1. SCM (Planning)\\1. Mr Thang\\2. Plan\\Summary data.xlsm\"), null, true),",
                "    #\"Opening Stock_Sheet\" = Source{[Item=\"Opening Stock\",Kind=\"Sheet\"]}[Data],",
                "    #\"Promoted Headers\" = Table.PromoteHeaders(#\"Opening Stock_Sheet\", [PromoteAllScalars=true]),",
                "    #\"Changed Type\" = Table.TransformColumnTypes(#\"Promoted Headers\",{{\"Material\", type text}, {\"From Date\", type text}, {\"To Date\", type date}, {\" Closing Stock\", type number}}),",
                "    #\"Replaced Value\" = Table.ReplaceValue(#\"Changed Type\",#date(2026, 4, 30),#date(2026, 5, 1),Replacer.ReplaceValue,{\"To Date\"}),",
                "    #\"Merged Queries\" = Table.NestedJoin(#\"Replaced Value\", {\"Material\"}, UoMTable, {\"Material\"}, \"UoM Additive\", JoinKind.LeftOuter),",
                "    #\"Expanded UoM Additive\" = Table.ExpandTableColumn(#\"Merged Queries\", \"UoM Additive\", {\"Base\"}, {\"Base\"}),",
                "    #\"Filtered Rows\" = Table.SelectRows(#\"Expanded UoM Additive\", each [Base] <> null and [Base] <> \"\"),",
                "    #\"Duplicated Column\" = Table.DuplicateColumn(#\"Filtered Rows\", \"Material\", \"Material - Copy\"),",
                "    #\"Extracted First Characters\" = Table.TransformColumns(#\"Duplicated Column\", {{\"Material - Copy\", each Text.Start(_, 8), type text}}),",
                "    #\"Renamed Columns\" = Table.RenameColumns(#\"Extracted First Characters\",{{\"Material - Copy\", \"Code 8\"}}),",
                "    #\"Removed Columns\" = Table.RemoveColumns(#\"Renamed Columns\",{\"Material\"}),",
                "    #\"Added Custom\" = Table.AddColumn(#\"Removed Columns\", \"Custom\", each [#\" Closing Stock\"]*[Base]),",
                "    #\"Changed Type1\" = Table.TransformColumnTypes(#\"Added Custom\",{{\"Custom\", type number}}),",
                "    #\"Removed Columns1\" = Table.RemoveColumns(#\"Changed Type1\",{\" Closing Stock\", \"Base\"}),",
                "    #\"Grouped Rows\" = Table.Group(#\"Removed Columns1\", {\"Code 8\", \"To Date\"}, {{\"Stock Kg\", each List.Sum([Custom]), type nullable number}})",
                "in",
                "    #\"Grouped Rows\""
              ],
              "type": "m"
            }
          }
        ]
      },
