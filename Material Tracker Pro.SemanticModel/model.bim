                "let",
                "    PP_Source = Excel.Workbook(File.Contents(\"D:\\Box\\05. Supply Chain Management\\1. SCM (Planning)\\1. Mr Thang\\2. Plan\\Summary data.xlsm\"), null, true),",
                "    #\"PP_Sheet\" = PP_Source{[Item=\"Production Plan\",Kind=\"Sheet\"]}[Data],",
                "    #\"PP_Changed Type\" = Table.TransformColumnTypes(#\"PP_Sheet\",{{\"Column1\", type date}, {\"Column2\", type text}, {\"Column3\", type text}, {\"Column4\", type text}, {\"Column5\", type text}, {\"Column6\", type any}, {\"Column7\", type any}, {\"Column8\", Int64.Type}, {\"Column9\", Int64.Type}, {\"Column10\", type text}, {\"Column11\", type text}, {\"Column12\", type text}, {\"Column13\", type text}, {\"Column14\", type text}, {\"Column15\", type text}, {\"Column16\", type text}, {\"Column17\", type text}, {\"Column18\", type text}, {\"Column19\", type text}, {\"Column20\", type text}, {\"Column21\", type text}, {\"Column22\", type text}, {\"Column23\", type any}, {\"Column24\", type any}, {\"Column25\", type any}, {\"Column26\", type any}, {\"Column27\", type any}, {\"Column28\", type any}, {\"Column29\", Int64.Type}, {\"Column30\", type any}, {\"Column31\", type any}, {\"Column32\", type any}, {\"Column33\", type any}, {\"Column34\", Int64.Type}, {\"Column35\", Int64.Type}}),",
                "    #\"PP_Promoted Headers\" = Table.PromoteHeaders(#\"PP_Changed Type\", [PromoteAllScalars=true]),",
                "    #\"PP_Removed Other Columns\" = Table.SelectColumns(#\"PP_Promoted Headers\",{\"Date\", \"Batch\", \"Code\", \"Product\", \"KL\", \"Catton\"}),",
                "    #\"PP_Changed Type1\" = Table.TransformColumnTypes(#\"PP_Removed Other Columns\",{{\"Date\", type date}, {\"Batch\", type text}, {\"Code\", type text}, {\"Product\", type text}, {\"KL\", type number}, {\"Catton\", Int64.Type}}),",
                "    #\"PP_Duplicated Column\" = Table.DuplicateColumn(#\"PP_Changed Type1\", \"Code\", \"Code - Copy\"),",
                "    #\"PP_Split Column by Delimiter\" = Table.SplitColumn(#\"PP_Duplicated Column\", \"Code - Copy\", Splitter.SplitTextByDelimiter(\"-\", QuoteStyle.Csv), {\"Code - Copy.1\", \"Code - Copy.2\"}),",
                "    #\"PP_Changed Type2\" = Table.TransformColumnTypes(#\"PP_Split Column by Delimiter\",{{\"Code - Copy.1\", type text}, {\"Code - Copy.2\", type text}}),",
                "    #\"PP_Removed Columns1\" = Table.RemoveColumns(#\"PP_Changed Type2\",{\"Code - Copy.2\"}),",
                "    PP_Table = Table.RenameColumns(#\"PP_Removed Columns1\",{{\"Code - Copy.1\", \"Code 8\"}}),",
                "    Dim_Source = Excel.Workbook(File.Contents(\"D:\\Box\\05. Supply Chain Management\\1. SCM (Planning)\\PowerBI\\Code LV.xlsx\"), null, true),",
                "    #\"Dim_Density Sheet\" = Dim_Source{[Item=\"Density-8digital code\",Kind=\"Sheet\"]}[Data],",
