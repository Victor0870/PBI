                "    #\"BOM_Renamed Columns\" = Table.RenameColumns(#\"BOM_Changed Type\",{{\"8 dit git\", \"Code 8\"}}),",
                "    #\"BOM_Duplicated Column\" = Table.DuplicateColumn(#\"BOM_Renamed Columns\", \"Comp Material\", \"Comp Material - Copy\"),",
                "    #\"BOM_Extracted First Characters\" = Table.TransformColumns(#\"BOM_Duplicated Column\", {{\"Comp Material - Copy\", each Text.Start(_, 8), type text}}),",
                "    BOMTable = Table.RenameColumns(#\"BOM_Extracted First Characters\",{{\"Comp Material - Copy\", \"Code 8 Material\"}}),",
                "    #\"Merged Queries\" = Table.NestedJoin(PP_Table, {\"Code 8\"}, DimMapping, {\"SAP code\"}, \"Dim_Mapping_Code\", JoinKind.LeftOuter),",
                "    #\"Expanded Dim_Mapping_Code\" = Table.ExpandTableColumn(#\"Merged Queries\", \"Dim_Mapping_Code\", {\"Mã_Bulk_Chuẩn\"}, {\"Mã_Bulk_Chuẩn\"}),",
                "    #\"Merged Queries1\" = Table.NestedJoin(#\"Expanded Dim_Mapping_Code\", {\"Mã_Bulk_Chuẩn\"}, BOMTable, {\"Code 8\"}, \"BOM\", JoinKind.LeftOuter),",
                "    #\"Expanded BOM\" = Table.ExpandTableColumn(#\"Merged Queries1\", \"BOM\", {\"Comp Material\", \"Material name\", \" (%)\", \"Density\"}, {\"Comp Material\", \"Material name\", \" (%)\", \"Density\"}),",
                "    #\"Divided Column\" = Table.TransformColumns(#\"Expanded BOM\", {{\" (%)\", each _ / 1000, type number}}),",
                "    #\"Changed Type3\" = Table.TransformColumnTypes(#\"Divided Column\",{{\" (%)\", Percentage.Type}}),",
                "    #\"Renamed Columns1\" = Table.RenameColumns(#\"Changed Type3\",{{\" (%)\", \"Percentage\"}}),",
                "    #\"Filtered Rows1\" = Table.SelectRows(#\"Renamed Columns1\", each [Batch] <> null and [Batch] <> \"\"),",
                "    #\"Added Custom\" = Table.AddColumn(#\"Filtered Rows1\", \"KG\", each [KL]*(if [Density] = null or [Density] = 0 then 0 else [Density])*1000),",
                "    #\"Changed Type5\" = Table.TransformColumnTypes(#\"Added Custom\",{{\"KG\", type number}}),",
